# Copy to .env (gitignored) and fill in, or export these directly in the
# systemd unit's Environment= lines — never commit the real bearer token.
BUGCATCHER_API_URL=https://bugs.anchoritegames.com/api/reports.php
BUGCATCHER_BEARER_TOKEN=
BUGCATCHER_DB_PATH=data/bug_processor.db
# same host as this processor — no Tailscale hop needed
AUTOPRODUCER_URL=http://127.0.0.1:8420
# the Auto-Producer project id bug-catcher tasks get created under; must
# already exist (create it once, by hand, in Auto-Producer). Leave unset to
# run pull/group/score only, with nothing pushed to Auto-Producer.
AUTOPRODUCER_PROJECT_ID=
